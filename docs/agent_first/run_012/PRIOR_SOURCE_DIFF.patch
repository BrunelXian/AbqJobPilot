+def wait(path, deadline, progress=None):
     while not path.exists():
         if time.monotonic() >= deadline:
             raise TimeoutError("Fixed fixture lifetime exceeded")
+        if progress:
+            progress('WAITING')
         time.sleep(0.01)
+
